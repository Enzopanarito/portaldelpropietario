{
  "name": "vla-portal",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "npm run test:release && npm run build:public",
    "build:public": "node scripts/build-production.js && node scripts/generate-social-card.js",
    "test:release": "npm test",
    "test": "node --test tests/*.test.js",
    "test:browser": "node --test tests/*.cjs",
    "verify": "node scripts/predeploy-check.js && npm test"
  },
  "dependencies": {
    "@netlify/blobs": "9.1.5",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.15.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17"
  },
  "overrides": {
    "nanoid": "3.3.18"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1"
  }
}
