# Runtime only. Do not commit real credentials.
PLATFORM_ENVIRONMENT=development

# Future company-owned control plane. Public URL/key may be exposed only where RLS permits it.
CONTROL_PLANE_SUPABASE_URL=
CONTROL_PLANE_SUPABASE_PUBLISHABLE_KEY=

# Server-only credentials must NEVER use NEXT_PUBLIC_ prefixes.
CONTROL_PLANE_SUPABASE_SECRET_KEY=

# One company/JV master key for app-side AES-256-GCM envelopes. Generate 32 random bytes and base64 encode them.
PLATFORM_SECRET_MASTER_KEY_B64=
PLATFORM_SECRET_KEY_VERSION=k1

# Optional future Supabase-for-Platforms OAuth application.
SUPABASE_PLATFORM_OAUTH_CLIENT_ID=
SUPABASE_PLATFORM_OAUTH_CLIENT_SECRET=
